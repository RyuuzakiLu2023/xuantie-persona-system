# XTMEM Hermes plugin config example.
# Place as $HERMES_HOME/xtmem.yaml (one file per profile). Missing file = defaults.
# Defaults come from memory.public_runtime.db_default() (~/.xtmem/vector_store.db,
# overridable with XTMEM_HOME / XTMEM_DB_PATH).

# Shared database. Relative paths resolve against the current working directory;
# `~` expands to the user home. Prefer leaving it unset and using XTMEM_DB_PATH
# when you need a second database for tests.
# db_path: "~/.xtmem/vector_store.db"

# Namespace is derived from the host's agent_identity / profile name (see
# provider.initialize). There is currently NO config override for it: a `namespace:`
# key in this file is read into the config dict but never applied by provider.py.
# To use a different namespace, set the host profile's identity instead.
#
# `project` likewise comes from the host's agent_workspace, not from this file.

# Context window used for budgeting (engine default 128k).
# context_window: 128000

# Optional override of config.yaml's memory_advanced block.
# memory_advanced:
#   embedding:
#     model: bge-m3
#     base_url: http://127.0.0.1:11434
#     timeout: 30
#   retrieval:
#     top_k: 10
#     token_budget: 2000
#     relevance_threshold: 0.15
#   compression:
#     enabled: true
#     max_entries: 10000
#     trigger_ratio: 0.9
#   prefetch_only: false
#   rest_api: false

# Recall quality gate: candidates scoring below this are not injected.
# 0.01 keeps legacy behaviour; 0.5 is a reasonable "only feed what fits" setting.
# prefetch_min_score: 0.01

# How long prefetch may block a turn (must stay below the host's 8s deadline).
# prefetch_wait_secs: 2.0

# Show why a memory was / was not injected in recall diagnostics.
# recall_diagnostics: false

# Inject the shared knowledge namespace in addition to the profile namespace.
# include_shared_knowledge: false

# Expose the read-only recall/lookup tools (xtmem_recall, xtmem_lookup).
# read_tools: false

# Duplicate-recall cooldown: same chunk is not injected twice within N seconds.
# recall_cooldown_secs: 600

# RecallPolicy tuning (all optional; see recall_policy.py for rule order).
# recall_policy:
#   enabled: true
#   min_message_length: 10
#   substantive_short_queries: false
#   always_recall_keywords: ["previously", "last time", "project"]
#   never_recall_keywords: ["ok", "thanks", "continue"]

# Activity hooks (off by default): record_events writes xtmem_events,
# record_utility accumulates chunk_utility on recall.
# stats:
#   record_events: false
#   record_utility: false
